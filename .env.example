# ==========================================================
# SISTEMA DA OFICINA
# Exemplo de variáveis de ambiente
# Não coloque senhas ou chaves reais neste arquivo.
# ==========================================================

# Banco de dados usado fora do Docker
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5432/sistema_oficina

# Segurança da aplicação
SECRET_KEY=COLOQUE_UMA_CHAVE_SECRETA_AQUI

# Ambiente
FLASK_ENV=production

# PostgreSQL do Docker
OFICINA_POSTGRES_DB=sistema_oficina
OFICINA_POSTGRES_USER=postgres
OFICINA_POSTGRES_PASSWORD=COLOQUE_A_SENHA_DO_POSTGRES_AQUI

# Evolution API / WhatsApp
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=COLOQUE_A_CHAVE_DA_EVOLUTION_AQUI
EVOLUTION_INSTANCE=Oficina